{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Archislop: Dev (server + web)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev",
      "envFile": "${workspaceFolder}/.env",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Server: Dev (compiled dist + watch)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev -w apps/server",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Server: Debug (compiled dist)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "program": "${workspaceFolder}/apps/server/dist/index.js",
      "preLaunchTask": "build:server",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": ["${workspaceFolder}/apps/server/**", "!**/node_modules/**"]
    },
    {
      "name": "Web: Dev (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev -w apps/web",
      "envFile": "${workspaceFolder}/.env",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ],
  "compounds": [
    {
      "name": "Archislop: Server + Web (two terminals)",
      "configurations": ["Server: Dev (compiled dist + watch)", "Web: Dev (Vite)"],
      "stopAll": true
    }
  ]
}
