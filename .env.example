PORT=4000
# Full-agent syntax-repair fallback attempts. Defaults: Fast=2, Quality=2 (per profile when unset).
# The single-shot syntax fixer runs once on top of this.
MERMAID_REPAIR_MAX_ATTEMPTS=
# Optional profile-specific full-agent repair caps. Defaults: Fast=2, Quality=2.
MERMAID_REPAIR_MAX_ATTEMPTS_FAST=
MERMAID_REPAIR_MAX_ATTEMPTS_QUALITY=
INFOGRAPHIC_REPAIR_MAX_ATTEMPTS=
INFOGRAPHIC_REPAIR_MAX_ATTEMPTS_FAST=
INFOGRAPHIC_REPAIR_MAX_ATTEMPTS_QUALITY=
CHART_REPAIR_MAX_ATTEMPTS=
CHART_REPAIR_MAX_ATTEMPTS_FAST=
CHART_REPAIR_MAX_ATTEMPTS_QUALITY=
METAPHOR_REPAIR_MAX_ATTEMPTS=
METAPHOR_REPAIR_MAX_ATTEMPTS_FAST=
METAPHOR_REPAIR_MAX_ATTEMPTS_QUALITY=
ANYTHING_REPAIR_MAX_ATTEMPTS=
ANYTHING_REPAIR_MAX_ATTEMPTS_FAST=
ANYTHING_REPAIR_MAX_ATTEMPTS_QUALITY=
# Absolute agent-stream run budgets in milliseconds. Defaults: Fast=75000, Quality=150000 (Go Mad: 105000 / 180000).
MERMAID_AGENT_RUN_BUDGET_MS_FAST=
MERMAID_AGENT_RUN_BUDGET_MS_QUALITY=
# Optional: pin the single-shot syntax fixer to a specific model id (defaults to the resolved fast tier).
MERMAID_REPAIR_MODEL=
# Optional: pin the syntax fixer backend independently of the intent backend (vertex | openrouter | deepseek).
MERMAID_REPAIR_BACKEND=
# When 1/true, emit one structured JSON line per agent turn (mode, model, validator, repair attempts, sanitizer hits, latency).
MERMAID_METRICS=
# Heartbeat cadence (ms) while an SSE stream is open with no normalized events (default 6000, clamped ≥1000, ≤60000).
MERMAID_STREAM_HEARTBEAT_MS=
# LangGraph ReAct step budget per agent run (default 50, clamped 25–200). Raise if you hit GRAPH_RECURSION_LIMIT.
MERMAID_AGENT_RECURSION_LIMIT=
# Max tool invocations per single agent run (default 10, clamped 4–40). Set to 0 to disable the cap.
MERMAID_AGENT_MAX_TOOL_CALLS_PER_RUN=
# Anything-mode runtime execution check (jsdom child process). Default 1 (on). Set to 0/false/off to skip.
ANYTHING_RUNTIME_CHECK=
# ANYTHING_RUNTIME_CHECK_TIMEOUT_MS=4000
# Direct DeepSeek API (local dev default when set). OpenAI-compatible: https://api.deepseek.com
DEEPSEEK_API_KEY=
# Default models when unset: Fast=deepseek-v4-flash, Quality=deepseek-v4-pro.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_MODEL_FAST=
DEEPSEEK_MODEL_QUALITY=
# DeepSeek V4 thinking mode (default off). Leave unset for diagram agents — tool loops require reasoning_content round-trips.
# DEEPSEEK_THINKING=1
OPENROUTER_API_KEY=
# Default models when unset: Fast=google/gemini-2.5-flash-lite (latency-tuned, reliable tool calls), Quality=qwen/qwen3-235b-a22b (flagship MoE).
# HK users with regional issues: set OPENROUTER_MODEL_FAST=qwen/qwen3-32b (or similar Qwen slug).
# Optional: one slug for both tiers when OPENROUTER_MODEL_FAST / OPENROUTER_MODEL_QUALITY are unset.
OPENROUTER_MODEL=
# Optional: UI “Fast” / “Quality” profiles (client sends enum only; never raw model ids).
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_QUALITY=
OPENROUTER_SITE_NAME=ArchiSlop
OPENROUTER_SITE_URL=http://localhost:5173
# LLM routing: auto (default) | vertex | openrouter | deepseek.
# auto: Cloud Run → Vertex (Gemini); local → DeepSeek if DEEPSEEK_API_KEY, else OpenRouter, else Vertex ADC.
# Override: LLM_PROVIDER=openrouter for local OpenRouter testing; OPENROUTER_PREFERRED=1 forces OpenRouter on Cloud Run too.
LLM_PROVIDER=
# When set to 1/true, auto mode uses OpenRouter before DeepSeek/Vertex when OPENROUTER_API_KEY is set.
OPENROUTER_PREFERRED=
# Vertex AI (Gemini on GCP). On Cloud Run, GOOGLE_CLOUD_PROJECT is set automatically; override with VERTEX_PROJECT_ID for local ADC tests.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=
# Built-in defaults (when unset): Fast=gemini-2.5-flash, Quality=gemini-2.5-pro (verified on mermaidgen/us-central1).
# When Gemini 3.x is available on your project, prefer: VERTEX_MODEL_FAST=gemini-3.5-flash, VERTEX_MODEL_QUALITY=gemini-3.1-pro-preview
VERTEX_MODEL_FAST=
VERTEX_MODEL_QUALITY=
# Thinking-panel USD estimates: auto-on when K_SERVICE is set (Cloud Run). Set LLM_COST_ESTIMATES=1 to preview locally.
# LLM_COST_ESTIMATES=
# Per-model overrides (USD per 1M tokens). See docs/llm-config.md and Vertex pricing.
# LLM_COST_USD_PER_M_GEMINI_2_5_FLASH_INPUT=0.30
# LLM_COST_USD_PER_M_GEMINI_2_5_FLASH_OUTPUT=2.50
# LLM_COST_USD_PER_M_GEMINI_2_5_PRO_INPUT=1.25
# LLM_COST_USD_PER_M_GEMINI_2_5_PRO_OUTPUT=10.00
VITE_API_BASE_URL=http://localhost:4000
# Public origin for MCP invite URLs and deeplinks (no trailing slash). Set on Cloud Run so invites use https://…run.app, not localhost.
# PUBLIC_BASE_URL=https://mermaid-gen-main-464241135431.us-central1.run.app
# Pairing code TTL (ms). Refreshed when Invite agent opens (default 60m max / 30m refresh).
# PAIRING_CODE_TTL_MS=3600000
# PAIRING_INVITE_TTL_MS=1800000
# HMAC secret for signed invite tokens (?token= on /mcp). Set in production.
# INVITE_TOKEN_SECRET=
# Optional Redis URL for pairing codes across Cloud Run instances (diagram state stays in-process).
# REDIS_URL=redis://localhost:6379
# MCP failed-pairing rate limit per client IP (defaults: 30 failures / 60s window).
# MCP_RATE_LIMIT_MAX_FAILURES=30
# REST join-room rate limit per client IP (defaults: 60 / 60s).
# API_JOIN_RATE_LIMIT_MAX=60
# REST LLM routes rate limit per client IP (defaults: 60 / 60s).
# API_LLM_RATE_LIMIT_MAX=60
# Production CORS: comma-separated extra origins (PUBLIC_BASE_URL is always allowed).
# CORS_ALLOWED_ORIGINS=
# Production Docker images omit this so the browser uses same-origin `/api/...`.
# Optional: subdirectory base for static assets at vite build time (Docker builds `/` and `/hackathon/` bundles).
# VITE_BASE_PATH=/
# Override Express static dirs when serving locally (defaults: apps/web/dist-main or apps/web/dist, apps/web/dist-hackathon).
# WEB_DIST_MAIN=
# WEB_DIST_HACKATHON=
