PORT=4000
MERMAID_MCP_URL=
MERMAID_MCP_MAX_RETRIES=2
MERMAID_MCP_RETRY_DELAY_MS=150
MERMAID_REPAIR_MAX_ATTEMPTS=1
# LangGraph ReAct step budget per agent run (default 50, clamped 25–200). Raise if you hit GRAPH_RECURSION_LIMIT.
MERMAID_AGENT_RECURSION_LIMIT=
# Max tool invocations per single agent run (default 6, clamped 4–40). Set to 0 to disable the cap.
MERMAID_AGENT_MAX_TOOL_CALLS_PER_RUN=
OPENROUTER_API_KEY=
# Default models when unset: Fast=Qwen3 8B, Quality=Qwen3 235B A22B MoE (OpenRouter slugs; HK-friendly).
# Optional: one slug for both tiers when OPENROUTER_MODEL_FAST / OPENROUTER_MODEL_QUALITY are unset.
OPENROUTER_MODEL=
# Optional: UI “Fast” / “Quality” profiles (client sends enum only; never raw model ids).
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_QUALITY=
OPENROUTER_SITE_NAME=Mermaid Architect
OPENROUTER_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
# Production Docker images omit this so the browser uses same-origin `/api/...`.
# Optional: subdirectory base for static assets at vite build time (Docker builds `/` and `/hackathon/` bundles).
# VITE_BASE_PATH=/
# Override Express static dirs when serving locally (defaults: apps/web/dist-main or apps/web/dist, apps/web/dist-hackathon).
# WEB_DIST_MAIN=
# WEB_DIST_HACKATHON=
