{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Mirror tsconfig.build.json so typecheck catches what the build catches.
    // Tests still get Node globals via `types: ["node"]`.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "./.tsbuildinfo",

    // Ratchet: run `npm run typecheck:strict -w apps/server` for strict TS islands.
    // Full shared strict is gated on the TS ratchet in docs/decisions/0006-typescript-migration.md.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}

