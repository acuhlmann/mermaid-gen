{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Strict island, mirroring apps/server/tsconfig.strict.json. The web app's
    // base tsconfig stays loose (strict:false) during the ADR-0006 ratchet; this
    // config strict-checks only the already-TypeScript files listed below.
    // Run `npm run typecheck:strict -w apps/web`.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/components/ExplainSectionsPanel.tsx",
    "src/components/PatchSummaryViz.tsx",
    "src/components/PlanBeatCard.tsx",
    "src/components/StyleEditsA2uiSurface.tsx",
    "src/components/StyleEditsPanel.tsx",
    "src/components/TechnicalActionStepper.tsx",
    "src/components/insightsEntryTypes.ts",
    "src/state/agentStreamInsightContext.ts",
    "src/state/agUiTranslator.ts",
    "src/state/applyAgentStreamInsightEvent.ts",
    "src/utils/agentStreamFailureStatus.ts",
    "src/utils/thinkingProseEnrich.tsx",
    "src/state/diagramWireTypes.ts",
    "src/state/diagramSession.ts",
    "src/state/copilotStreamHttpAgent.ts"
  ]
}
